          <mxGeometry x="50" y="225" width="1500" height="60" as="geometry" />
        </mxCell>
        <mxCell id="points" value="&lt;div style=&quot;margin-bottom:16px&quot;&gt;• Use AI to widen the space of possibilities.&lt;/div&gt;&lt;div style=&quot;margin-bottom:16px&quot;&gt;• Use evidence to decide what deserves action.&lt;/div&gt;&lt;div style=&quot;margin-bottom:16px&quot;&gt;• Build your career around judgment and reliable execution.&lt;/div&gt;&lt;div style=&quot;margin-bottom:16px&quot;&gt;• Panel question: which alumni problem has both value and a credible evaluator?&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontColor=#eff6ff;fontSize=24;" vertex="1" parent="1">
