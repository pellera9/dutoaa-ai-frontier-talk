        </mxCell>
        <mxCell id="points" value="&lt;div style=&quot;margin-bottom:16px&quot;&gt;• Confident errors and unsupported citations.&lt;/div&gt;&lt;div style=&quot;margin-bottom:16px&quot;&gt;• Sensitive data and malicious instructions in retrieved content.&lt;/div&gt;&lt;div style=&quot;margin-bottom:16px&quot;&gt;• Unequal outcomes, deskilling and unclear responsibility.&lt;/div&gt;&lt;div style=&quot;margin-bottom:16px&quot;&gt;• Use bounded permissions, evidence checks and accountable review.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontColor=#eff6ff;fontSize=24;" vertex="1" parent="1">
          <mxGeometry x="50" y="305" width="1450" height="260" as="geometry" />
