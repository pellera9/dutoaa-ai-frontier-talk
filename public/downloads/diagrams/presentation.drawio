          <mxGeometry x="50" y="30" width="1500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="title" value="Scientific AI is a broader ecosystem than LLMs" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=52;fontStyle=1;fontColor=#eff6ff;" vertex="1" parent="1">
          <mxGeometry x="50" y="90" width="1500" height="130" as="geometry" />
        </mxCell>
        <mxCell id="zh" value="科学 AI 不只有大语言模型。" style="text;html=1;whiteSpace=wrap;align=left;fontSize=28;fontColor=#b8a6ff;" vertex="1" parent="1">
          <mxGeometry x="50" y="225" width="1500" height="60" as="geometry" />
        </mxCell>
        <mxCell id="points" value="&lt;div style=&quot;margin-bottom:16px&quot;&gt;• AlphaFold 3 predicts structures of biomolecular complexes.&lt;/div&gt;&lt;div style=&quot;margin-bottom:16px&quot;&gt;• Specialized predictors and generators support different tasks.&lt;/div&gt;&lt;div style=&quot;margin-bottom:16px&quot;&gt;• LLMs can help connect literature, code and tools.&lt;/div&gt;&lt;div style=&quot;margin-bottom:16px&quot;&gt;• Structure, function, mechanism and clinical benefit require different evidence.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontColor=#eff6ff;fontSize=24;" vertex="1" parent="1">
          <mxGeometry x="50" y="305" width="1450" height="260" as="geometry" />
        </mxCell>
        <mxCell id="n0" value="Structure: what shape?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#14283a;strokeColor=#71dfce;fontColor=#eff6ff;fontSize=23;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="600" width="265" height="96" as="geometry" />
        </mxCell>
        <mxCell id="n1" value="Function: what effect?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#14283a;strokeColor=#71dfce;fontColor=#eff6ff;fontSize=23;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="350" y="600" width="265" height="96" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="Mechanism: what process?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#14283a;strokeColor=#71dfce;fontColor=#eff6ff;fontSize=23;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="650" y="600" width="265" height="96" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="Intervention: what changes?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#14283a;strokeColor=#71dfce;fontColor=#eff6ff;fontSize=23;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="950" y="600" width="265" height="96" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="Outcome: useful and safe?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#14283a;strokeColor=#71dfce;fontColor=#eff6ff;fontSize=23;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1250" y="600" width="265" height="96" as="geometry" />
        </mxCell>
        <mxCell id="e0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#aab7c6;endArrow=block;" edge="1" parent="1" source="n0" target="n1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#aab7c6;endArrow=block;" edge="1" parent="1" source="n1" target="n2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#aab7c6;endArrow=block;" edge="1" parent="1" source="n2" target="n3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#aab7c6;endArrow=block;" edge="1" parent="1" source="n3" target="n4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="caption" value="A shape prediction does not by itself identify function, mechanism or therapeutic benefit." style="text;html=1;whiteSpace=wrap;align=left;fontSize=19;fontColor=#aab7c6;" vertex="1" parent="1">
          <mxGeometry x="50" y="762" width="1500" height="48" as="geometry" />
