        <mxCell id="eyebrow" value="15 / 16 · Responsible adoption · 26:30–28:00" style="text;html=1;align=left;fontSize=22;fontColor=#71dfce;" vertex="1" parent="1">
          <mxGeometry x="50" y="30" width="1500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="title" value="Run one measured pilot in the next 30 days" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=52;fontStyle=1;fontColor=#eff6ff;" vertex="1" parent="1">
          <mxGeometry x="50" y="90" width="1500" height="130" as="geometry" />
        </mxCell>
        <mxCell id="zh" value="30 天内做一个可衡量、可复盘的试点。" style="text;html=1;whiteSpace=wrap;align=left;fontSize=28;fontColor=#b8a6ff;" vertex="1" parent="1">
          <mxGeometry x="50" y="225" width="1500" height="60" as="geometry" />
        </mxCell>
        <mxCell id="points" value="&lt;div style=&quot;margin-bottom:16px&quot;&gt;• Week 1: choose a task, owner and baseline.&lt;/div&gt;&lt;div style=&quot;margin-bottom:16px&quot;&gt;• Week 2: define inputs, checks and bounded access.&lt;/div&gt;&lt;div style=&quot;margin-bottom:16px&quot;&gt;• Week 3: compare matched tasks and record failures.&lt;/div&gt;&lt;div style=&quot;margin-bottom:16px&quot;&gt;• Week 4: decide to expand, revise or stop.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontColor=#eff6ff;fontSize=24;" vertex="1" parent="1">
          <mxGeometry x="50" y="305" width="1450" height="260" as="geometry" />
