  <diagram id="09 research" name="09 research">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" background="#091622">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="eyebrow" value="09 / 16 · Science · 16:00–17:30" style="text;html=1;align=left;fontSize=22;fontColor=#71dfce;" vertex="1" parent="1">
          <mxGeometry x="50" y="30" width="1500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="title" value="Research agents need feedback from the world" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=52;fontStyle=1;fontColor=#eff6ff;" vertex="1" parent="1">
          <mxGeometry x="50" y="90" width="1500" height="130" as="geometry" />
        </mxCell>
        <mxCell id="zh" value="研究智能体需要来自真实世界的反馈。" style="text;html=1;whiteSpace=wrap;align=left;fontSize=28;fontColor=#b8a6ff;" vertex="1" parent="1">
          <mxGeometry x="50" y="225" width="1500" height="60" as="geometry" />
        </mxCell>
        <mxCell id="points" value="&lt;div style=&quot;margin-bottom:16px&quot;&gt;• Coscientist demonstrated tool-connected laboratory workflows.&lt;/div&gt;&lt;div style=&quot;margin-bottom:16px&quot;&gt;• AlphaEvolve connects program proposals to automated evaluation.&lt;/div&gt;&lt;div style=&quot;margin-bottom:16px&quot;&gt;• The evaluator determines what progress means.&lt;/div&gt;&lt;div style=&quot;margin-bottom:16px&quot;&gt;• Simulation success needs an appropriate bridge to reality.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontColor=#eff6ff;fontSize=24;" vertex="1" parent="1">
          <mxGeometry x="50" y="305" width="1450" height="260" as="geometry" />
        </mxCell>
        <mxCell id="n0" value="Define objective" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#14283a;strokeColor=#71dfce;fontColor=#eff6ff;fontSize=23;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="600" width="265" height="96" as="geometry" />
        </mxCell>
        <mxCell id="n1" value="Propose candidates" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#14283a;strokeColor=#71dfce;fontColor=#eff6ff;fontSize=23;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
