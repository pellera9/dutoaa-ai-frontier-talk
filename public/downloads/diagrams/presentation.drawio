        <mxCell id="title" value="Read the evidence before repeating the headline" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=52;fontStyle=1;fontColor=#eff6ff;" vertex="1" parent="1">
          <mxGeometry x="50" y="90" width="1500" height="130" as="geometry" />
        </mxCell>
        <mxCell id="zh" value="先判断证据，再传播结论。" style="text;html=1;whiteSpace=wrap;align=left;fontSize=28;fontColor=#b8a6ff;" vertex="1" parent="1">
          <mxGeometry x="50" y="225" width="1500" height="60" as="geometry" />
        </mxCell>
        <mxCell id="points" value="&lt;div style=&quot;margin-bottom:16px&quot;&gt;• Ask who made the claim and when.&lt;/div&gt;&lt;div style=&quot;margin-bottom:16px&quot;&gt;• Read the exact problem and assumptions.&lt;/div&gt;&lt;div style=&quot;margin-bottom:16px&quot;&gt;• Locate the paper, code, data or certificate.&lt;/div&gt;&lt;div style=&quot;margin-bottom:16px&quot;&gt;• Separate artifact checking, scientific acceptance and practical usefulness.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontColor=#eff6ff;fontSize=24;" vertex="1" parent="1">
          <mxGeometry x="50" y="305" width="1450" height="260" as="geometry" />
