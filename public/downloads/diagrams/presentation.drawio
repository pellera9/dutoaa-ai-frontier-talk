          <mxGeometry x="950" y="600" width="265" height="96" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="Accept or revise" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#14283a;strokeColor=#71dfce;fontColor=#eff6ff;fontSize=23;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
