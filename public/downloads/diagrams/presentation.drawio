        <mxCell id="n0" value="Text + structures + data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#14283a;strokeColor=#71dfce;fontColor=#eff6ff;fontSize=23;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="600" width="265" height="96" as="geometry" />
        </mxCell>
        <mxCell id="n1" value="Shared latent state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#14283a;strokeColor=#71dfce;fontColor=#eff6ff;fontSize=23;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="350" y="600" width="265" height="96" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="Dynamics + intervention" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#14283a;strokeColor=#71dfce;fontColor=#eff6ff;fontSize=23;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="650" y="600" width="265" height="96" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="Observable predictions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#14283a;strokeColor=#71dfce;fontColor=#eff6ff;fontSize=23;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="950" y="600" width="265" height="96" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="Compare mechanisms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#14283a;strokeColor=#71dfce;fontColor=#eff6ff;fontSize=23;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1250" y="600" width="265" height="96" as="geometry" />
        </mxCell>
        <mxCell id="e0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#aab7c6;endArrow=block;" edge="1" parent="1" source="n0" target="n1">
