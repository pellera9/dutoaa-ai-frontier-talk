          <mxGeometry x="50" y="30" width="1500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="title" value="From prediction and generation to testable mechanisms" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=52;fontStyle=1;fontColor=#eff6ff;" vertex="1" parent="1">
          <mxGeometry x="50" y="90" width="1500" height="130" as="geometry" />
        </mxCell>
        <mxCell id="zh" value="从预测与生成，走向可检验的机制假说。" style="text;html=1;whiteSpace=wrap;align=left;fontSize=28;fontColor=#b8a6ff;" vertex="1" parent="1">
          <mxGeometry x="50" y="225" width="1500" height="60" as="geometry" />
        </mxCell>
        <mxCell id="points" value="&lt;div style=&quot;margin-bottom:16px&quot;&gt;• Repository contribution: Shengchao Liu’s Wave Intelligence perspective.&lt;/div&gt;&lt;div style=&quot;margin-bottom:16px&quot;&gt;• Connect text, structures and measurements through shared representations.&lt;/div&gt;&lt;div style=&quot;margin-bottom:16px&quot;&gt;• Model how a system evolves under conditions and interventions.&lt;/div&gt;&lt;div style=&quot;margin-bottom:16px&quot;&gt;• Compare alternative mechanisms using observable predictions.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontColor=#eff6ff;fontSize=24;" vertex="1" parent="1">
          <mxGeometry x="50" y="305" width="1450" height="260" as="geometry" />
