        <mxCell id="zh" value="把验证建设成基础设施。" style="text;html=1;whiteSpace=wrap;align=left;fontSize=28;fontColor=#b8a6ff;" vertex="1" parent="1">
          <mxGeometry x="50" y="225" width="1500" height="60" as="geometry" />
        </mxCell>
        <mxCell id="points" value="&lt;div style=&quot;margin-bottom:16px&quot;&gt;• Specify what a valid answer must satisfy.&lt;/div&gt;&lt;div style=&quot;margin-bottom:16px&quot;&gt;• Use checks that can reject the proposal.&lt;/div&gt;&lt;div style=&quot;margin-bottom:16px&quot;&gt;• Keep provenance, assumptions and failure cases.&lt;/div&gt;&lt;div style=&quot;margin-bottom:16px&quot;&gt;• Spend verification effort where errors matter most.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontColor=#eff6ff;fontSize=24;" vertex="1" parent="1">
          <mxGeometry x="50" y="305" width="1450" height="260" as="geometry" />
        </mxCell>
        <mxCell id="n0" value="Acceptance criteria" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#14283a;strokeColor=#71dfce;fontColor=#eff6ff;fontSize=23;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="600" width="265" height="96" as="geometry" />
        </mxCell>
        <mxCell id="n1" value="Generate candidate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#14283a;strokeColor=#71dfce;fontColor=#eff6ff;fontSize=23;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
