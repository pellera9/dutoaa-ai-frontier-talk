              <mxPoint x="482" y="740" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="caption" value="Use checks capable of rejecting a generated result; select the reviewer and criteria before acting." style="text;html=1;whiteSpace=wrap;align=left;fontSize=19;fontColor=#aab7c6;" vertex="1" parent="1">
